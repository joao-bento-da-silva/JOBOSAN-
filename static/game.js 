function desenharTabuleiro() {
    const elementoTabuleiro = document.getElementById("tabuleiro");
    elementoTabuleiro.innerHTML = ""; // Limpa o tabuleiro antes de redesenhar

    for (let y = 0; y < TAMANHO_TABULEIRO; y++) {
        for (let x = 0; x < TAMANHO_TABULEIRO; x++) {
            const casa = document.createElement("div");
            casa.classList.add("casa");

            // Alterna a cor padrão do xadrez (claro/escuro)
            if ((x + y) % 2 === 0) {
                casa.classList.add("casa-clara");
            } else {
                casa.classList.add("casa-escura");
            }

            const valor = tabuleiro[y][x];

            // 1. SE FOR PAREDE (VALOR 1): Pinta de preto / aplica visual de muro
            if (valor === 1) {
                casa.classList.add("parede"); 
                casa.style.backgroundColor = "#111111"; // Cor preta para o muro do labirinto
            } 
            // 2. SE FOR REU/CORTE OU PLEBEUS
            else if (valor === 4) {
                casa.innerHTML = "👑"; // Rei
            } else if (valor === 5) {
                casa.innerHTML = "♛"; // Rainha
            } else if (valor === 6) {
                casa.innerHTML = "♗"; // Bispo
            } else if (valor >= 10) {
                casa.innerHTML = "🛡️"; // Plebeu
            } else if (valor === 99) {
                casa.innerHTML = "🚪"; // Porta de saída
            }

            // Adiciona o evento de clique na casa
            casa.onclick = () => aoClicarNaCasa(x, y);

            elementoTabuleiro.appendChild(casa);
        }
    }
}
 
