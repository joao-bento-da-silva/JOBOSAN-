 function moverPerseguidores() {
    const fase = FASES[faseAtual];
    
    for (let y = 0; y < TAMANHO_TABULEIRO; y++) {
        for (let x = 0; x < TAMANHO_TABULEIRO; x++) {
            const val = tabuleiro[y][x];
            let tipo = null;
            if (val === 4) tipo = 'rei';
            else if (val === 5) tipo = 'rainha';
            else if (val === 6) tipo = 'bispo';
            if (!tipo) continue;
            
            // Encontra o plebeu mais próximo
            let alvo = null;
            let menorDist = Infinity;
            for (let py = 0; py < TAMANHO_TABULEIRO; py++) {
                for (let px = 0; px < TAMANHO_TABULEIRO; px++) {
                    if (tabuleiro[py][px] >= 10) {
                        const dist = Math.abs(px - x) + Math.abs(py - y);
                        if (dist < menorDist) {
                            menorDist = dist;
                            alvo = {x: px, y: py};
                        }
                    }
                }
            }
            if (!alvo) continue;
            
            // Calcula movimento original
            let nx = x, ny = y;
            if (tipo === 'rei' || tipo === 'rainha') {
                if (alvo.x > x) nx++;
                else if (alvo.x < x) nx--;
                else if (alvo.y > y) ny++;
                else if (alvo.y < y) ny--;
            }
            if (tipo === 'bispo') {
                if (alvo.x > x && alvo.y > y) { nx++; ny++; }
                else if (alvo.x < x && alvo.y > y) { nx--; ny++; }
                else if (alvo.x > x && alvo.y < y) { nx++; ny--; }
                else if (alvo.x < x && alvo.y < y) { nx--; ny--; }
            }
            
            // Valida movimento
            if (nx >= 0 && nx < TAMANHO_TABULEIRO && ny >= 0 && ny < TAMANHO_TABULEIRO) {
                if (tabuleiro[ny][nx] === 0 || tabuleiro[ny][nx] >= 10) {
                    if (tabuleiro[ny][nx] >= 10) {
                        capturado();
                        return;
                    }
                    tabuleiro[y][x] = 0;
                    tabuleiro[ny][nx] = val;
                }
            }
        }
    }
}
