 function moverPerseguidores() {
    const listaPerseguidores = [];

    // Identifica cada perseguidor no tabuleiro.
    for (let y = 0; y < TAMANHO_TABULEIRO; y++) {
        for (let x = 0; x < TAMANHO_TABULEIRO; x++) {
            const val = tabuleiro[y][x];

            if (val === 4) {
                listaPerseguidores.push({ x, y, tipo: "rei", val });
            } else if (val === 5) {
                listaPerseguidores.push({ x, y, tipo: "rainha", val });
            } else if (val === 6) {
                listaPerseguidores.push({ x, y, tipo: "bispo", val });
            }
        }
    }

    for (const p of listaPerseguidores) {
        // Não processa uma peça que já não esteja na posição original.
        if (tabuleiro[p.y][p.x] !== p.val) continue;

        // Procura o plebeu mais próximo.
        let alvo = null;
        let menorDist = Infinity;

        for (let py = 0; py < TAMANHO_TABULEIRO; py++) {
            for (let px = 0; px < TAMANHO_TABULEIRO; px++) {
                if (tabuleiro[py][px] >= 10) {
                    const dist = Math.abs(px - p.x) + Math.abs(py - p.y);
                    if (dist < menorDist) {
                        menorDist = dist;
                        alvo = { x: px, y: py };
                    }
                }
            }
        }

        if (!alvo) continue;

        let nx = p.x;
        let ny = p.y;

        if (p.tipo === "rei") {
            // Rei: uma casa em qualquer direção
            if (alvo.x > p.x) nx++;
            else if (alvo.x < p.x) nx--;
            if (alvo.y > p.y) ny++;
            else if (alvo.y < p.y) ny--;
        }
        else if (p.tipo === "rainha") {
            // Rainha: uma casa, mas pode ser reta OU diagonal
            const dx = alvo.x - p.x;
            const dy = alvo.y - p.y;
            if (Math.abs(dx) >= Math.abs(dy) && dx !== 0) {
                nx = p.x + (dx > 0 ? 1 : -1);
            }
            else if (dy !== 0) {
                ny = p.y + (dy > 0 ? 1 : -1);
            }
        }
        else if (p.tipo === "bispo") {
            //  BISPO: SÓ se move na DIAGONAL
            const dx = alvo.x - p.x;
            const dy = alvo.y - p.y;
            
            // Verificação CHAVE: só se move se estiver na diagonal
            const estaNaDiagonal = Math.abs(dx) === Math.abs(dy);
            
            if (!estaNaDiagonal) {
                continue; // Fora da diagonal = NÃO se move!
            }
            
            // Se chegou aqui, está na diagonal — move uma casa na direção certa
            nx = p.x + (dx > 0 ? 1 : -1);
            ny = p.y + (dy > 0 ? 1 : -1);
        }

        // Verifica os limites do tabuleiro.
        if (nx < 0 || nx >= TAMANHO_TABULEIRO || ny < 0 || ny >= TAMANHO_TABULEIRO) {
            continue;
        }

        const destino = tabuleiro[ny][nx];

        // Não atravessa paredes nem soldados.
        if (destino === 1 || destino === 3) continue;

        // Não permite que dois perseguidores ocupem a mesma casa.
        if (destino === 4 || destino === 5 || destino === 6) continue;

        // Captura um plebeu se a casa de destino estiver ocupada por ele.
        if (destino >= 10) {
            capturado();
            continue;
        }

        // Só move a peça se o destino estiver vazio.
        if (destino === 0) {
            tabuleiro[p.y][p.x] = 0;
            tabuleiro[ny][nx] = p.val;
        }
    }
}
