 function moverPerseguidores() {
    // Lista para processar cada perseguidor apenas UMA vez por turno
    const perseguidores = [];

    for (let y = 0; y < TAMANHO_TABULEIRO; y++) {
        for (let x = 0; x < TAMANHO_TABULEIRO; x++) {
            const val = tabuleiro[y][x];
            if (val === 4) perseguidores.push({ x, y, tipo: 'rei', val });
            else if (val === 5) perseguidores.push({ x, y, tipo: 'rainha', val });
            else if (val === 6) perseguidores.push({ x, y, tipo: 'bispo', val });
        }
    }

    perseguidores.forEach(p => {
        // Confirma se o perseguidor ainda está no tabuleiro (não foi sobrescrito)
        if (tabuleiro[p.y][p.x] !== p.val) return;

        // Encontra o plebeu mais próximo
        let alvo = null;
        let menorDist = Infinity;

        for (let py = 0; py < TAMANHO_TABULEIRO; py++) {
            for (let px = 0; px < TAMANHO_TABULEIRO; px++) {
                if (tabuleiro[py][px] >= 10) {
                    const dist = Math.abs(px - p.x) + Math.abs(py - p.y);
                    if (dist < menorDist) {
                        menorDist = dist;
                        alvo = { x: px, y: py };
                    }
                }
            }
        }

        if (!alvo) return;

        let nx = p.x;
        let ny = p.y;

        // Movimento do Rei e Rainha (passo de 1 casa em qualquer direção)
        if (p.tipo === 'rei' || p.tipo === 'rainha') {
            if (alvo.x > p.x) nx++;
            else if (alvo.x < p.x) nx--;
            
            if (alvo.y > p.y) ny++;
            else if (alvo.y < p.y) ny--;
        }

        // Movimento estrito do Bispo (APENAS DIAGONAL PURA - NUNCA RETA)
        if (p.tipo === 'bispo') {
            const dx = alvo.x - p.x;
            const dy = alvo.y - p.y;

            // O bispo SÓ PODE se mover se houver variação tanto em X quanto em Y
            if (dx !== 0 && dy !== 0) {
                nx += dx > 0 ? 1 : -1;
                ny += dy > 0 ? 1 : -1;
            } else {
                // Se o plebeu estiver na mesma linha ou coluna, o bispo FICA PARADO 
                nx = p.x;
                ny = p.y;
            }
        }

        // Validação de limites do tabuleiro
        if (nx >= 0 && nx < TAMANHO_TABULEIRO && ny >= 0 && ny < TAMANHO_TABULEIRO) {
            const destino = tabuleiro[ny][nx];

            // Bloqueia se tentar andar em paredes (1) ou soldados (3)
            if (destino === 1 || destino === 3) return;

            // Se atingir um Plebeu
            if (destino >= 10) {
                capturado();
                return;
            }

            // Move se a casa estiver vazia (0)
            if (destino === 0) {
                tabuleiro[p.y][p.x] = 0;
                tabuleiro[ny][nx] = p.val;
            }
        }
    });
}
